# ========================================================
# SEnergyS Africa - Configuration Apache / OVHcloud
# ========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirection transparente de toutes les requêtes /api/* vers le moteur PHP
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. Gestion du routage React SPA (évite les 404 sur /admin/login, /carrieres, etc.)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Protection des fichiers de configuration et base de données JSON
<FilesMatch "(\.json|\.env|\.sql|\.log|\.ovhconfig)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# En-têtes de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Activation de la compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
